  "scripts": {
    "postinstall": "npx --no-install patch-package || true",
    "dev": "node --no-deprecation --max-old-space-size=8192 node_modules/@angular/cli/bin/ng.js serve",
    "dev:all": "node --no-deprecation --max-old-space-size=8192 node_modules/@angular/cli/bin/ng.js serve",
    "wp:publish": "node --no-deprecation scripts/publish_article_to_wordpress.mjs",
    "data:ingest": "node --no-deprecation scripts/ingest-public-data.mjs",
    "data:evidence": "npx tsx scripts/ingest_nih_who_corpus.ts",
    "data:parquet": ".\\.venv\\Scripts\\python.exe scripts/export_clinical_parquet.py",
    "models:train": ".\\.venv\\Scripts\\python.exe scripts/train_clinical_edge_model.py",
    "infer": "node --no-deprecation scripts/run_local_inference.mjs",
    "models:retrain": "node --no-deprecation scripts/retrain-models.mjs",
    "dataset:export": "node --no-deprecation scripts/export_fine_tuning_dataset.mjs",
    "sentinel:audit": "node --no-deprecation scripts/sentinel_security_guard.mjs",
    "msa:audit": "node --no-deprecation scripts/msa_governance_guard.mjs",
    "taint:scan": "node --no-deprecation scripts/taint-analysis-guard.mjs",
    "evals:clinical": "node --no-deprecation scripts/run-clinical-evals.mjs",
    "doctor:wsl": "node --no-deprecation scripts/wsl_ai_doctor.mjs",
    "clamav:scan": "node --no-deprecation scripts/daily-clamav-scan.mjs",
    "sbom": "node --no-deprecation scripts/generate_cyclonedx_sbom.mjs",
    "sbom:generate": "node --no-deprecation scripts/generate_cyclonedx_sbom.mjs",
    "mcp:warmup": "node --no-deprecation scripts/mcp-warmup.js",
    "build": "node --no-deprecation scripts/build-all.mjs",
    "deploy": "node --no-deprecation scripts/deploy-production.mjs",
    "deploy:all": "node --no-deprecation scripts/deploy-production.mjs",
    "gh:watch": "gh run watch",
    "gh:status": "gh run list --limit 5",
    "gh:failed": "gh run view --log-failed",
    "gh:pr": "gh pr create --fill",
    "gh:release": "node --no-deprecation scripts/gh-release.mjs",
    "gh:attest:verify": "gh attestation verify oci://ghcr.io/pocketgull-app/pocketgull:latest --owner pocketgull-app",
    "specimen:rams": "dart run scripts/dart/render_rams_specimen.dart",
    "social:cards": "dart run scripts/dart/render_social_cards.dart",
    "dart:fonts": "dart run scripts/dart/deploy_fonts.dart",
    "dart:parity": "dart run scripts/dart/generate_parity.dart",
    "dart:docs": "dart run scripts/dart/generate_docs.dart",
    "dart:tags": "dart run scripts/dart/kaggle_tags.dart",
    "dart:submissions": "dart run scripts/dart/package_submissions.dart",
    "dart:usability10": "dart run scripts/dart/prepare_usability10_dataset.dart",
    "dart:debt": "dart run scripts/dart/debt_zen_solver.dart",
    "agy:verify": "dart run scripts/dart/verify_agy_skills.dart",
    "gcp:prune-storage": "node --no-deprecation ./scripts/apply-gcp-lifecycle-policies.mjs",
    "grants:sbir": "node --no-deprecation ./scripts/generate_sbir_grant_binder.mjs",
    "models:hub-export": "node --no-deprecation ./scripts/huggingface_model_hub_export.mjs",
    "contracts:generate": "node --no-deprecation ./scripts/generate-api-contracts.mjs",
    "lint": "node --no-deprecation node_modules/typescript/lib/tsc.js -p tsconfig.json --noEmit",
    "preview": "node --no-deprecation scripts/build-if-missing.cjs && node --no-deprecation dist/server/server.mjs",
    "serve:local": "node --no-deprecation scripts/serve-local.mjs",
    "test:e2e": "node --no-deprecation ./run-playwright.cjs test",
    "changelog": "echo \"Remember to update CHANGELOG.md before running npm run release\"",
    "serve:ssr:app": "node --no-deprecation dist/server/server.mjs",
    "start": "node --no-deprecation dist/server/server.mjs",
    "gcp-build": "npm run build && npm prune --production",
    "audit": "lighthouse http://localhost:4000 --view",
    "estimate-effort": "node --no-deprecation scripts/estimate-effort.js",
    "estimate-effort:detailed": "node scripts/estimate-effort-detailed.js",
    "precommit": "node scripts/pre-commit-check.cjs",
    "prepare": "node -e \"try { require('husky')() } catch (e) {}\" || true",
    "test": "vitest run --config vitest.config.ts && node scripts/run-python-tests.mjs",
    "test:fast": "vitest run --changed",
    "test:watch": "vitest",
    "typecheck:fast": "node node_modules/typescript/lib/tsc.js -p tsconfig.json --noEmit",
    "test:python": "node scripts/run-python-tests.mjs",
    "test:e2e:ui": "playwright test --ui",
    "dns:update": "node scripts/update-porkbun-dns.js",
    "kube:start": "minikube start",
    "kube:dev": "skaffold dev",
    "kube:stop": "minikube stop"
  },
